[Unit]
Description=FlowTrim flow-log reducer for Falcon Next-Gen SIEM
Documentation=https://github.com/tripnine/flowtrim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flowtrim
Group=flowtrim
# HEC_URL=... and HEC_TOKEN=... (chmod 600, owned by root)
EnvironmentFile=/etc/flowtrim/flowtrim.env
ExecStartPre=/usr/local/bin/flowtrim check -config /etc/flowtrim/flowtrim.yaml
ExecStart=/usr/local/bin/flowtrim run -config /etc/flowtrim/flowtrim.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
TimeoutStopSec=45
StateDirectory=flowtrim
LimitNOFILE=65536
# Lets FlowTrim raise SO_RCVBUF above net.core.rmem_max (SO_RCVBUFFORCE).
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/flowtrim
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
